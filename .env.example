WEB_HOST=127.0.0.1
WEB_PORT=3000
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4725
DATABASE_URL=postgresql://phone_farm:CHANGE_ME@127.0.0.1:5432/phone_farm
POSTGRES_DB=phone_farm
POSTGRES_USER=phone_farm
POSTGRES_PASSWORD=CHANGE_ME
# Comma-separated ESM packages. Empty is a valid fleet-only installation.
PHONE_FARM_PLUGINS=
TIKTOK_BUNDLE_ID=com.zhiliaoapp.musically
# Required before WEB_HOST is changed away from loopback.
# PHONE_FARM_AUTH_PLUGIN=@your-organization/phone-farm-auth
DEVICES_CONFIG_PATH=devices.json
# Device unlock passcodes live in devices.json ("passcode" per entry), which is
# git-ignored and written 0600 — not in this file.
SCHEDULER_DATA_DIR=.scheduler-data
WDA_LOCAL_PORT=8100
MJPEG_LOCAL_PORT=9100

# Optional. `wda:prepare` / `wda:start` target the sole registered (devices.json)
# or connected device, or take `--udid <udid>`. Set this only to pin one device
# for the CLI scripts. `xcrun xctrace list devices` lists UDIDs.
# IOS_UDID=
IOS_PLATFORM_VERSION=16.7
# Required for WDA build/signing on a physical device.
XCODE_ORG_ID=replace-me
XCODE_SIGNING_ID=Apple Development
WDA_BUNDLE_ID=com.example.WebDriverAgentRunner

# Content library. Bookmarking TikTok posts calls the Apify TikTok scraper;
# without a token the library page loads but ingestion returns 503.
APIFY_API_TOKEN=
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
# Folder of your own images that generated posts are built from.
CONTENT_GALLERY_DIR=./gallery
# Slide text is rendered by Fal's image editor; unset (or CONTENT_SLIDE_TEXT=local)
# falls back to the built-in sharp/SVG renderer. Video text is always local.
FAL_API_KEY=
CONTENT_FAL_MODEL=fal-ai/nano-banana-pro/edit
CONTENT_FAL_TIMEOUT_MS=180000
# CONTENT_SLIDE_TEXT=local

# ── iCloud Shared Album Sync ──────────────────────────────────────────────────
# Shared albums sync into gallery/<album-name>/ on every `npm run start`.
# Get the URL: open icloud.com/photos → Shared Albums → click album → share icon → "Copy Link"
# SHARED_ALBUM_THASAN_PIXL=https://www.icloud.com/sharedalbum/#TOKEN
# SHARED_ALBUM_PIXL_ROBOTICS=https://www.icloud.com/sharedalbum/#TOKEN
# SHARED_ALBUM_NOMAD_FOUNDER=https://www.icloud.com/sharedalbum/#TOKEN
# Generation shells out to the locally installed Claude Code CLI.
CLAUDE_BIN=claude
CONTENT_CLAUDE_MODEL=sonnet
CONTENT_GENERATE_TIMEOUT_MS=600000
# Where generated posts are written (generatedPosts/{YYYY-MM-DD}/post_NNN/).
CONTENT_OUTPUT_DIR=generatedPosts

# Required to draft or publish a video. Slideshow posts do not use this.
# Also used as a fallback when Claude Code CLI rate-limits during content generation.
OPENROUTER_API_KEY=
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash-vision-exp
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
